<?xml version="1.0"?>
<ruleset name="Mywp">
	<description>Sniffs for the coding standards of The Sun.</description>

	<!-- Scanning preferences -->
	<arg value="s"/> <!-- Show sniff and progress -->
	<arg name="colors"/> <!-- Show results with colors. Disable if working on Windows -->
	<arg name="basepath" value="."/> <!-- Strip the file paths down to the relevant bit -->
	<arg name="parallel" value="8"/> <!-- Enables parallel processing when available for faster results -->
	<arg name="extensions" value="php"/> <!-- Limit to PHP files -->
	<arg name="error-severity" value="1"/>
	<arg name="warning-severity" value="1"/>

	<file>.</file>

	<!-- Exclude vendor directories -->
	<exclude-pattern>node_modules/</exclude-pattern>
	<exclude-pattern>vendor/</exclude-pattern>

	<!-- Include WordPress ruleset -->
	<rule ref="WordPress" />

	<!-- Include WordPress Core ruleset -->
	<rule ref="WordPress-Core"/>

	<!-- Include WordPress-Extra ruleset -->
	<rule ref="WordPress-Extra"/>

	<!-- Rules: VIP Coding Standards - see https://github.com/Automattic/VIP-Coding-Standards -->
	<rule ref="WordPress-VIP-Go"/>

	<!-- Don't report the short array issue, as this is fine for VIP env -->
	<rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.Arrays.DisallowShortArraySyntax.Found">
		<severity>0</severity>
	</rule>

	<!-- Don't report minified files that are not named *.min.* -->
	<rule ref="Internal.Tokenizer.Exception">
		<severity>0</severity>
	</rule>

	<!-- Don't report .php files with no PHP in them -->
	<rule ref="Internal.NoCodeFound">
		<severity>0</severity>
	</rule>

	<!--
	All rules temporarily reduce the severity of things not yet fixed.
	The violations should be fixed and these overrides remove over time.
	-->
	<rule ref="Generic.CodeAnalysis.EmptyStatement.DetectedCatch">
		<severity>1</severity>
	</rule>
	<rule ref="Generic.CodeAnalysis.UselessOverridingMethod.Found">
		<severity>1</severity>
	</rule>
	<rule ref="Generic.Commenting.DocComment.LongNotCapital">
		<severity>1</severity>
	</rule>
